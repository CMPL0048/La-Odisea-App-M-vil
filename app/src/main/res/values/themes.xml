<resources>
    <style name="Theme.LaOdisea" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/odisea_paper</item>
    </style>

    <style name="Theme.LaOdisea.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/odisea_green</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_logo_fg</item>
        <item name="postSplashScreenTheme">@style/Theme.LaOdisea</item>
    </style>
</resources>
